# Copy to .env and fill in. .env is gitignored and denied to Claude's Read tool.
# (This file is named env.example rather than .env.example because Claude's
# user-global permission layer denies writes to .env* paths; rename if desired.)

# Read-only Postgres connection to the GEM project database replica.
# Used by ../gem-db-ops (the pull engine) and by scripts/scope_filter.py /
# scripts/entity_lookup.py. Sessions are forced read-only server-side.
GEM_READONLY_DB_URL=postgres://readonly:PASSWORD@HOST:5432/DBNAME

# Optional: JSONL audit log path for url_verifier.py (defaults under work/).
URL_VERIFIER_LOG=
