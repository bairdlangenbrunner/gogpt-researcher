# Auth and secrets
.env

# Data pulls and derived files (fresh-pulled every batch, never committed)
*.colmap.json
*.csv
!campaigns/**/roster.csv
!emissions/coverage/*.csv
!emissions/findings/*.csv
!emissions/sources/*.csv
# emissions source downloads: large third-party files, register is sources/downloads.csv
emissions/sources/raw/

# Derived sweep / worklist outputs (regenerable by worklist.py / scope_filter.py /
# qc_checks.py). Scripts default to writing under work/ (ignored except its
# .gitkeep). The bare filenames are also ignored for the case where a script is
# run with an explicit cwd-relative --output.
work/*
!work/.gitkeep
scripts/work/
worklist.json
scope_report.json
qc_checks.json

# Per-batch staged inputs / agent-authored findings. Loose copies in the repo
# root or scripts/ are scratch and stay ignored — the organized home is the
# per-scope staging tree (see batches/README.md):
#   batches/<scope>/staging/    agent-authored research JSON (TRACKED — diffable audit trail)
#   batches/<scope>/staging-<mode>/  same, for a second mode run in the same cycle (docs/workflows.md)
staged_*.json
!batches/*/staging/**/staged_*.json
!batches/*/staging-*/**/staged_*.json

# Derived build scratch (assembled staged_*.json regenerated each run).
batches/*/staging/_build/

# State sweeps (notes/us_state_agent_plan.md): briefs, shards, comparison.json,
# sweep_args.json and the calibration memo are the audit trail and ARE tracked.
# Only the per-URL verifier logs and the blind-mode hidden values are scratch.
batches/*/shards/*.urls.jsonl
batches/*/briefs/_hidden/
!batches/*/staging/comparison.json
!batches/*/staging/sweep_args.json

# Batch deliverable workbooks are large regenerable binaries — never tracked
# (the committed half of a deliverable pair is the evidence .md; see
# batches/README.md).
batches/*/staging/**/*.xlsx
batches/*/deliverables/*.xlsx
batches/*/archive/*.xlsx
batches/old/

# upstream/gogpt-tracker (verbatim import of the GOGPT leads' pipeline):
# dumps are multi-MB and regenerable via scripts/export_to_dump.py; the
# possible-updates CSV contains researcher names and this repo is PUBLIC —
# it must never be committed (the global *.csv rule above also covers it;
# this line is belt-and-suspenders documentation of intent).
upstream/gogpt-tracker/data/GOGPTall*.xlsx
upstream/gogpt-tracker/data/GEM_trackers__possible_updates__*.csv

# Python
.pytest_cache/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# Transient scheduler artifacts (session-local cron lock/state from CronCreate)
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# OS
.DS_Store
Thumbs.db

# codegraph local index (derived)
.codegraph/
